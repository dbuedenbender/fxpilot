<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dbuedenbender.fxpilot.examples</groupId>
    <artifactId>fxpilot-demo</artifactId>
    <version>1.1.1</version>
    <packaging>jar</packaging>

    <name>FxPilot Demo</name>
    <description>"Order Desk", a JavaFX demo application for trying FxPilot, its safety settings and replay plans.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.6</javafx.version>
        <fxpilot.version>1.1.1</fxpilot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.dbuedenbender</groupId>
            <artifactId>fxpilot</artifactId>
            <version>${fxpilot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.github.dbuedenbender.fxpilot.demo.DemoApp</mainClass>
                    <options>
                        <option>-Dfxpilot.port=8765</option>
                    </options>
                </configuration>
                <executions>
                    <!-- mvn javafx:run@safe: token file, destructive controls locked, escape hatches off -->
                    <execution>
                        <id>safe</id>
                        <configuration>
                            <options>
                                <option>-Dfxpilot.port=8765</option>
                                <option>-Dfxpilot.token=auto</option>
                                <option>-Dfxpilot.deny=#deleteAllButton,#resetButton,.danger</option>
                                <option>-Dfxpilot.dangerous=false</option>
                            </options>
                        </configuration>
                    </execution>
                    <!-- mvn javafx:run@readonly: the agent may look, but not touch -->
                    <execution>
                        <id>readonly</id>
                        <configuration>
                            <options>
                                <option>-Dfxpilot.port=8765</option>
                                <option>-Dfxpilot.readonly=true</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
