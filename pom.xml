<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dbuedenbender</groupId>
    <artifactId>fxpilot</artifactId>
    <version>1.1.1</version>
    <packaging>jar</packaging>

    <name>FxPilot</name>
    <description>Local HTTP endpoint that lets AI agents drive JavaFX applications via MCP (library and Java agent).</description>
    <url>https://github.com/dbuedenbender/fxpilot</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>dbuedenbender</id>
            <name>FxPilot contributors</name>
            <url>https://github.com/dbuedenbender</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/dbuedenbender/fxpilot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/dbuedenbender/fxpilot.git</developerConnection>
        <url>https://github.com/dbuedenbender/fxpilot</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/dbuedenbender/fxpilot/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <javafx.version>11.0.2</javafx.version>
        <junit.version>5.14.4</junit.version>
        <!-- The code compiles against JavaFX 11 (the minimum it supports). The headless UI tests run on a
             newer JavaFX, because JavaFX 11 crashes in its native font code on current JDKs. -->
        <javafx.test.version>21.0.6</javafx.test.version>
        <monocle.version>21.0.2</monocle.version>
        <!-- Set by jacoco:prepare-agent; extra JVM options for the tests go into surefire.jvmArgs. -->
        <argLine></argLine>
        <surefire.jvmArgs></surefire.jvmArgs>
    </properties>

    <dependencies>
        <!-- Provided by the host application; only javafx.controls (and javafx.graphics) is required. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fxpilot</finalName>
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <!-- explicit categories: -Xlint:all would pick up new categories of newer JDKs and fail -Werror -->
                        <arg>-Xlint:cast,deprecation,dep-ann,divzero,empty,fallthrough,finally,overrides,rawtypes,removal,serial,static,try,unchecked,varargs</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>@{argLine} ${surefire.jvmArgs}</argLine>
                    <!-- Tests run on the classpath (the JavaFX test runtime and Monocle are classpath jars);
                         McpProtocolTest starts the MCP server once on the module path to check module-info. -->
                    <useModulePath>false</useModulePath>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.openjfx:javafx-controls</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-graphics</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-base</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <additionalClasspathDependencies>
                        <additionalClasspathDependency>
                            <groupId>org.openjfx</groupId>
                            <artifactId>javafx-base</artifactId>
                            <version>${javafx.test.version}</version>
                            <classifier>${javafx.test.platform}</classifier>
                        </additionalClasspathDependency>
                        <additionalClasspathDependency>
                            <groupId>org.openjfx</groupId>
                            <artifactId>javafx-graphics</artifactId>
                            <version>${javafx.test.version}</version>
                            <classifier>${javafx.test.platform}</classifier>
                        </additionalClasspathDependency>
                        <additionalClasspathDependency>
                            <groupId>org.openjfx</groupId>
                            <artifactId>javafx-controls</artifactId>
                            <version>${javafx.test.version}</version>
                            <classifier>${javafx.test.platform}</classifier>
                        </additionalClasspathDependency>
                        <!-- WebView, for the positive fx_web tests (loaded reflectively, like in the endpoint). -->
                        <additionalClasspathDependency>
                            <groupId>org.openjfx</groupId>
                            <artifactId>javafx-web</artifactId>
                            <version>${javafx.test.version}</version>
                            <classifier>${javafx.test.platform}</classifier>
                        </additionalClasspathDependency>
                        <additionalClasspathDependency>
                            <groupId>org.openjfx</groupId>
                            <artifactId>javafx-media</artifactId>
                            <version>${javafx.test.version}</version>
                            <classifier>${javafx.test.platform}</classifier>
                        </additionalClasspathDependency>
                        <!-- Headless glass platform, so the scene-graph tests run without a display (CI). -->
                        <additionalClasspathDependency>
                            <groupId>org.testfx</groupId>
                            <artifactId>openjfx-monocle</artifactId>
                            <version>${monocle.version}</version>
                        </additionalClasspathDependency>
                    </additionalClasspathDependencies>
                    <systemPropertyVariables>
                        <glass.platform>Monocle</glass.platform>
                        <monocle.platform>Headless</monocle.platform>
                        <prism.order>sw</prism.order>
                        <java.awt.headless>true</java.awt.headless>
                        <!-- larger than the fixture window; the default 1280x800 makes Monocle's painter overflow -->
                        <headless.geometry>1920x1200-32</headless.geometry>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>io.github.dbuedenbender.fxpilot.FxPilotAgent</Premain-Class>
                            <Agent-Class>io.github.dbuedenbender.fxpilot.FxPilotAgent</Agent-Class>
                            <Main-Class>io.github.dbuedenbender.fxpilot.mcp.FxPilotMcpServer</Main-Class>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Coverage gate: the measured level is 81 % overall (endpoint 81 %, internal 87 %, MCP 81 %);
                         the gate sits a few points below that so a regression fails while ordinary changes do not. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Codes holds only error-code constants; it has no behavior to cover. -->
                            <excludes>
                                <exclude>io.github.dbuedenbender.fxpilot.Codes</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.78</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.78</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- The JSON and token-file code is shared by both sides and small; keep it above 85 %. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.dbuedenbender.fxpilot.internal</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Source jar: required by Maven Central -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc jar: required by Maven Central -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <locale>en</locale>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!-- Native classifier of the JavaFX runtime used by the tests. -->
        <profile>
            <id>fx-test-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><javafx.test.platform>win</javafx.test.platform></properties>
        </profile>
        <profile>
            <id>fx-test-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties><javafx.test.platform>linux</javafx.test.platform></properties>
        </profile>
        <profile>
            <id>fx-test-mac</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><javafx.test.platform>mac</javafx.test.platform></properties>
        </profile>
        <profile>
            <id>fx-test-mac-aarch64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><javafx.test.platform>mac-aarch64</javafx.test.platform></properties>
        </profile>

        <!-- Release only: mvnw.cmd -Prelease deploy (GPG signs artifacts, which CI must not do) -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>